# En desarrollo se muestran los borradores por defecto.
# Para mostrarlos en una compilación local de prueba:
# SHOW_DRAFTS=true
# Para ocultarlos incluso en desarrollo:
# SHOW_DRAFTS=false

# Envío real de consultas: completar únicamente en .env.local o en el servidor.
# RESEND_API_KEY=re_...
# CONTACT_FROM_EMAIL=Centro de Hoteles <consultas@tu-dominio-verificado.com>
