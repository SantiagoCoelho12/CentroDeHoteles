{
  "name": "centro-de-hoteles-la-paloma",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo del Centro de Hoteles de La Paloma. Primera etapa: datos y estructura.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "test": "node --test tests/detail.test.mjs tests/inquiry.test.mjs tests/phone.test.mjs tests/availability.test.mjs tests/language.test.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run validate:data && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:publish": "node scripts/validate-data.mjs --publish"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
